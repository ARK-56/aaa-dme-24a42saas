# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key from Settings → API. The anon key is safe to expose:
# row level security decides what it can actually read or write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Public origin, used for canonical and Open Graph URLs.
# Defaults to https://aaadmeinc.com; override on preview deployments.
NEXT_PUBLIC_SITE_URL=

# ── EmailJS ─────────────────────────────────────────────────────────────────
# Browser credentials for the contact form, footer CTA and intake modal.
# Account confirmation email is handled by Supabase Auth, not here.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_REQUEST_TEMPLATE_ID=
