# Redis connection string for the JSON document store behind /api/db/*
# e.g. redis://default:password@host:port
REDIS_URL=

# Resend credentials used by /api/send-verification
RESEND_API_KEY=
# Must be a domain verified in your Resend account
RESEND_FROM_EMAIL="AAA DME <verification@example.com>"

# EmailJS browser credentials for the contact form, footer CTA and intake modal
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_REQUEST_TEMPLATE_ID=

# Public site origin, used for canonical and Open Graph URLs.
# Defaults to https://aaadmeinc.com; override on preview deployments.
NEXT_PUBLIC_SITE_URL=
